{
  "firestore": [
    {
      "database": "greenwindow",
      "rules": "Firebase/firestore.rules"
    }
  ],
  "functions": [
    {
      "source": "Firebase/functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ]
}
